<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app
		title="Friday Night Funkin': PaoPao Engine"
		file="PaoPaoEngine"
		packageName="com.paopao.paopaoengine"
		package="com.paopao.paopaoengine"
		main="Main"
		version="0.2.8"
		company="Paopaodev"
	/>

	<echo value="PaoPao Engine - awesome fnf engine"/>
	<echo value="Make a mod to UHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH"/>
	<echo value="PaoPao Engine is compile for ${project.target} on a ${project.host} machine"/>

	<!--Switch
	Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef
		name="LINC_LUA_RELATIVE_DYNAMIC_LIB"
	/> <!-- stable luas PUT AFTER FIRST LINE WITH APP NAME AND
	ETC -->

	<!--The
	flixel preloader is not accurate in Chrome. You can use it regularly if you embed the swf into a
	html file
		or you can set the actual size of your file manually at "FlxPreloaderBase-onUpdate-bytesTotal"-->
	<!-- <app preloader="Preloader" resizable="true" /> -->
	<app preloader="flixel.system.FlxPreloader" />

	<!-- <app preloader="Preloader" /> -->


	<!--Minimum
	without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ______________________ PSYCH ENGINE CUSTOMIZATION ______________________ -->

	<define name="MODS_ALLOWED" />
	<define name="HSCRIPT_ALLOWED" if="MODS_ALLOWED" />
	<define name="PYTHON_ALLOWED" if="MODS_ALLOWED" />
	<define name="LUA_ALLOWED" if="MODS_ALLOWED cpp" unless="hl || html5" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="DISCORD_ALLOWED" if="cpp desktop" unless="hl || html5" />
	<define name="TRANSLATIONS_ALLOWED" />

	<define name="officialBuild" />

	<define name="MULTITHREADED_LOADING" unless="html5" />
	<haxedef name="NDLLS_SUPPORTED" unless="web || iphonesim || hl" />

	<define name="SHOW_LOADING_SCREEN" />

	<section unless="noBaseGameFile">
		<define name="BASE_GAME_FILES" />
	</section>

	<define
		name="VIDEOS_ALLOWED"
		if="cpp"
		unless="32bits || hl || html5"
	/>

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These
	window settings apply to all targets-->
	<window
		width="1280"
		height="720"
		fps="60"
		background="#000000"
		hardware="true"
		vsync="false"
		allow-high-dpi="true"
		allow-shaders="true"
	/>

	<!--HTML5-specific-->
	<window if="html5" resizable="true" />

	<!--Desktop-specific-->
	<window
		if="desktop"
		orientation="landscape"
		fullscreen="false"
		resizable="true"
		vsync="false"
	/>

	<!--Mobile-specific-->
	<window
		if="mobile"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="false"
	/>

	<!--Switch-specific-->
	<window
		if="switch"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="true"
	/>

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<source name="source" />

	<!-- __________________________ Game Assets & Etc. __________________________ -->

	<!-- Turn on Crash Handler -->
	<define name="CRASH_HANDLER" if="desktop release" />
	<define name="CRASH_DEBUGGER" if="CRASH_HANDLER desktop cpp" />
	<!-- <haxelib name="" if="CRASH_DEBUGGER"/> -->

	<!-- Assets -->
	<assets path="assets/fonts" />
	<assets path="assets/shared" exclude="*.ogg" if="web" />
	<assets path="assets/shared" exclude="*.mp3" unless="web" />
	<assets path="assets/embed" exclude="*.ogg" if="web" embed="true" />
	<assets path="assets/embed" exclude="*.mp3" unless="web" embed="true" />
	<assets path="assets/videos" if="VIDEOS_ALLOWED" />
	<assets path="assets/songs" exclude="*.ogg" if="web" />
	<assets path="assets/songs" exclude="*.mp3" unless="web" />
	<assets path="assets/week_assets" rename="assets" exclude="*.ogg" if="web" />
	<assets
		path="assets/week_assets"
		rename="assets"
		exclude="*.mp3"
		unless="web"
	/>

	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" exclude="*.ogg" if="web" />
		<assets
			path="assets/translations"
			rename="assets"
			exclude="*.mp3"
			unless="web"
		/>
	</section>

	<section if="BASE_GAME_FILES">
		<assets path="assets/base_game" rename="assets" exclude="*.ogg" if="web" />
		<assets path="assets/base_game" rename="assets" exclude="*.mp3" unless="web" />
	</section>

	<haxelib name="grig.audio" />
	<!-- <haxelib name="funkin.vis" /> -->

	<define name="CHECK_FOR_UPDATES" if="desktop officialBuild" />

	<section if="MODS_ALLOWED">
		<assets
			path='example_mods'
			rename='mods'
			embed='false'
			type='template'
			unless="mac"
		/>
		<assets path='example_mods' rename='mods' embed='false' if="mac" />
		<assets path='list.txt' rename='modsList.txt' />
	</section>
	<assets path='art/readme.txt' rename='do NOT readme.txt' />

	<!-- OpenAL config -->
	<section if="desktop">
		<assets
			path="alsoft.txt"
			rename="plugins/alsoft.ini"
			type="text"
			if="windows"
		/>
		<assets
			path="alsoft.txt"
			rename="plugins/alsoft.conf"
			type="text"
			unless="windows"
		/>
	</section>

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" version="6.1.2" />
	<haxelib name="flixel-addons" version="4.0.1" />
	<haxelib name="flixel-waveform" />
	<haxelib name="random" />
	<haxelib name="hxhardware" if="desktop cpp" />
	<define name="SlWindowsAPI" if="windows desktop cpp" />
	<haxelib name="sl-windows-api" if="SlWindowsAPI" />

	<haxelib name="tjson" version="1.4.0" />
	<haxelib name="hxWindowColorMode" if="windows desktop cpp" />
	<haxelib name="compiletime" />

	<!-- Libraries needed-->
	<haxelib name="linc_luajit" if="LUA_ALLOWED" />
	<haxelib name="lscript" if="LUA_ALLOWED" />
	<haxelib name="hython" if="PYTHON_ALLOWED" />
	<haxelib name="hscript-improved" if="HSCRIPT_ALLOWED" />
	<define name="hscript" if="HSCRIPT_ALLOWED debug" />

	<haxelib name="hxvlc" if="VIDEOS_ALLOWED" version="git" />
	<haxelib name="hxdiscord_rpc" version="git" if="DISCORD_ALLOWED" />
	<haxelib name="flxanimate" version="git" />

	<!-- Disable Discord IO Thread -->
	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux" />

	<!-- Enables a terminal log prompt on debug builds -->
	<haxelib name="hxcpp-debug-server" if="debug" />
	<haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
	<haxedef name="HXVLC_NO_SHARE_DIRECTORY" if="VIDEOS_ALLOWED" />
	<define name="x86_BUILD" if="32bits" />

	<!-- hscript config define -->
	<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />
	<define name="CUSTOM_CLASSES" if="HSCRIPT_ALLOWED" />
	
	<haxedef name="analyzer-module" />
	<haxedef name="analyzer-optimize" />

	<!-- ______________________________ Haxedefines _____________________________ -->

	<!--Enable
	the Flixel core recording system-->
	<!--<haxedef
	name="FLX_RECORD" />-->

	<!--Disable
	the right and middle mouse buttons-->
	<!-- <haxedef name="FLX_NO_MOUSE_ADVANCED" /> -->

	<!--Disable
	the native cursor API on Flash-->
	<!--<haxedef
	name="FLX_NO_NATIVE_CURSOR" />-->

	<!--Optimise
	inputs, be careful you will get null errors if you don't use conditionals in your game-->
	<!-- <haxedef name="FLX_NO_MOUSE" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_KEYBOARD" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_TOUCH" if="desktop" /> -->
	<!--<haxedef
	name="FLX_NO_GAMEPAD" />-->

	<!--Disable
	the Flixel core sound tray-->
	<!--<haxedef
	name="FLX_NO_SOUND_TRAY" />-->

	<!--Disable
	the Flixel sound management code-->
	<!--<haxedef
	name="FLX_NO_SOUND_SYSTEM" />-->

	<!--Disable
	the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<!-- Show debug traces for hxCodec -->
	<haxedef name="HXC_DEBUG_TRACE" if="debug" />

	<!--Disable
	the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!--Enable
	this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<section if="cpp">
		<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
		<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER" />
		<haxedef name="HXCPP_STACK_TRACE" if="CRASH_HANDLER" />
		<haxedef name="HXCPP_OPTIMIZE_LINK" unless="debug" />
		<haxedef name="HXCPP_GC_BIG_BLOCKS" />
		<haxedef name="HXCPP_GC_DYNAMIC_SIZE" />
		<haxedef name="HXCPP_GC_GENERATIONAL" />
		<haxedef name="HXCPP_CPP_GC_MARK_MOVE" />
		<haxedef name="HXCPP_CHECK_POINTER" />
		<haxedef name="HXCPP_CPP11" />
		<haxedef name="HXCPP-DEBUGGER" if="debug" />
	</section>

	<section if="android">
		<dependency name="c++_shared" />
		<haxedef name="HXCPP_CLANG" />
		<haxedef name="HXCPP_ARM_MODE" value="thumb2" />
		
		<haxedef name="android" />
		
		<android permission="android.permission.READ_EXTERNAL_STORAGE"/>
		<android permission="android.permission.WRITE_EXTERNAL_STORAGE"/>
		<android permission="android.permission.INTERNET"/>

		<set name="debug" if="debug" />
		<haxeflag name="-debug" if="debug" />
	</section>

	<!--Disable
	deprecated warnings-->
	<haxedef name='no-deprecation-warnings' />

	<!-- Haxe 4.3.0+: Enable pretty syntax errors and stuff. -->
	<!-- pretty (haxeflixel default), indent, classic (haxe compiler default) -->
	<haxedef name="message.reporting" value="pretty" />

	<!--Macro
	fixes-->
	<haxeflag name="--macro" value="include('my.pack')" />


	<!-- <haxedef name="pythonPos" if="PYTHON_ALLOWED" /> -->

	<!-- _________________________________ Custom _______________________________ -->

	<assets path='art/icons/iconOG.png' rename='icon.png' if="linux || mac" />

	<icon path="art/icons/icon16.png" size='16' />
	<icon path="art/icons/icon32.png" size='32' />
	<icon path="art/icons/icon64.png" size='64' />
	<icon path="art/icons/iconOG.png" />
</project>
